# --- virtual environment ----------------------------------------------------
# Never commit this: it stores absolute paths and breaks on any other machine.
# Recreate it with .\setup.ps1
.venv/
venv/

# --- working data -------------------------------------------------------------
# Keep the folders, never their contents.
input_files/*
output_files/*
!input_files/.gitkeep
!output_files/.gitkeep

# No PDF is tracked anywhere. Test fixtures and merge-assumption files are all
# generated by scripts, so nothing is lost by excluding them.
*.pdf

# Local notes and working documents.
*_spec.md
NOTES.md

# Only the example config is tracked; real ones carry local paths.
config.yaml
configs/
*.local.yaml

# Reports embed input file names and sha256 hashes. Match them wherever they
# land, not just under output_files/ -- --report takes an arbitrary path, so a
# run launched from the repo root drops report.json right here.
report.json
report.txt
*_report.json
*_report.txt
*_split.json
_batch_summary.*
_run_summary.json

# --- generated test artefacts -------------------------------------------------
# Rebuilt on demand by tests/make_fixtures.py and tests/merge_assumption/make_ab.py
tests/fixtures/
tests/merge_assumption/out/

# --- python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# --- editors and OS ------------------------------------------------------------
.vscode/
.idea/
Thumbs.db
desktop.ini
